        "z": "7197e169396119ce",
        "name": "function 1",
        "func": "const T = 2;\nconst RANGES = { s1: [0, 100], s2: [-20, 80], s3: [2, 400] };\n\nconst text = String(msg.payload).replace(/^\\uFEFF/, '');\nconst sql = [];\n\ntext.split(/\\r?\\n/).forEach(raw => {\n    const line = raw.trim();\n    if (!line) return;\n\n    const parts = line.split(' ');\n    const kind = parts[0];\n\n    const f = {};\n    parts.slice(1).forEach(p => {\n        const kv = p.split('=');\n        f[kv[0]] = kv[1];\n    });\n\n    const n = parseInt(f.n);\n    if (isNaN(n)) return;\n    const t = n * T;\n\n    if (kind === 'DATA') {\n        ['s1', 's2', 's3'].forEach(s => {\n            const v = parseFloat(f[s]);\n            if (isNaN(v)) return;\n            sql.push(`INSERT INTO readings(n,t_s,sensor,value) VALUES(${n},${t},'${s}',${v});`);\n            const r = RANGES[s];\n            if (v < r[0] || v > r[1]) {\n                sql.push(`INSERT INTO events(n,t_s,type,message) VALUES(${n},${t},'FAULT','датчик ${s} вне диапазона');`);\n            }\n        });\n    } else if (kind === 'EVENT') {\n        if (f.type === 'THRESHOLD' || f.type === 'NORMAL') {\n            sql.push(`INSERT INTO events(n,t_s,type,message) VALUES(${n},${t},'${f.type}',NULL);`);\n        }\n    }\n});\n\nif (sql.length === 0) {\n    node.warn('Нет команд');\n    return [null, null];\n}\n\nconst head = 'BEGIN;\\nDELETE FROM readings;\\nDELETE FROM events;\\n' +\n    \"DELETE FROM sqlite_sequence WHERE name IN ('readings','events');\\n\";\nreturn [null, { payload: head + sql.join('\\n') + '\\nCOMMIT;\\n' }];",
